# Copy to .env for Compose, or .env.local for native development. Never commit it.
# Generate independent random hex values: openssl rand -hex 32
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002
ALLOWED_EMAILS=operator@example.org
DATABASE_URL=postgresql://threatdeck:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5436/threatdeck
REDIS_URL=redis://localhost:6380
# Login email is separate from outbound publishing. Configure a verified sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Every optional service is opt-in; credentials alone never enable it.
ENABLE_AI=false
ENABLE_OUTBOUND_EMAIL=false
ENABLE_X_PUBLISHING=false
ENABLE_GMAIL_ACCESS=false
ENABLE_MEDIA_GENERATION=false
ENABLE_AUTOMATION=false
ENABLE_PUBLIC_FEED=false
# Synthetic collector samples are opt-in. Demo mode disables publishing and autonomous jobs.
ENABLE_DEMO_DATA=false
# Leave disabled until you provide OS/filesystem/network isolation for the parser.
# This experimental server override includes DOCX, XLS/XLSX, CSV and TSV.
ENABLE_OFFICE_INGESTION=false
# Optional extra HTTPS/WSS origins for custom HLS streams or a separate relay.
# Comma-separated exact origins only; no wildcards or scheme-wide allowances.
CSP_CONNECT_ORIGINS=
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
ANTHROPIC_DAILY_CAP_USD=50
OPENAI_API_KEY=
OUTBOUND_VISUAL_DAILY_SPEND_USD_HARD=30
IMAGE_RESERVATION_USD=5
VIDEO_RESERVATION_USD=20
# Use a PRIVATE Blob store. Never reuse a public upload store.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_WS_URL=
# Separate relay deployments share this key and Redis; use >=32 random characters.
WS_AUTH_SECRET=
CRON_SECRET=
TRUST_PROXY=false
# Native local development only. Production always rejects this bypass.
AUTH_DEV_BYPASS=false
AUTH_DEV_EMAIL=operator@example.org
INSTALL_DEMO_DATA=false
# Optional cyber collectors
NVD_API_KEY=
ABUSECH_AUTH_KEY=
TWITTER_BEARER_TOKEN=
FIRECRAWL_API_KEY=
# Outbound email / delegated Gmail (see docs/PRIVACY.md)
ALERT_EMAIL_RECIPIENTS=
EMAIL_LINK_BASE_URL=http://localhost:3002
EMAIL_PROVIDER=resend
EMAIL_DOMAIN_ALLOWLIST=
EMAIL_ME_RECIPIENT=
GMAIL_SENDER=
GMAIL_INBOX=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# X OAuth: use a separate encryption key (openssl rand -hex 32).
OAUTH_ENCRYPTION_KEY=
TWITTER_OAUTH_HANDLE=
TWITTER_OAUTH_CLIENT_ID=
TWITTER_OAUTH_CLIENT_SECRET=
TWITTER_OAUTH_REDIRECT_URI=http://localhost:3002/api/twitter/oauth/callback
# Optional video worker. No vendor CLI credentials are bundled.
HIGGSFIELD_REMOTE_URL=
INTERNAL_RENDER_SECRET=
ENABLE_HIGGSFIELD_VIDEO=false
