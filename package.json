{
  "name": "@cocoa-labs/threat-deck",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "dev:feeds": "tsx --watch src/lib/feeds/standalone.ts",
    "dev:full": "tsx --watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "lint": "eslint src/ --max-warnings=0",
    "format": "biome format --write src/",
    "check": "biome check src/ --error-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:migrate:status": "tsx src/lib/db/migrate-status.ts",
    "db:migrate:make": "tsx src/lib/db/migrate-make.ts",
    "backfill:nvd-history": "tsx scripts/backfill-nvd-history.ts",
    "train:exploit-forecaster": "tsx scripts/train-exploit-forecaster.ts",
    "test:unit": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "typecheck": "tsc --noEmit",
    "test:db:prepare": "node scripts/prepare-test-db.mjs",
    "test:container": "node scripts/container-smoke.mjs",
    "files:cleanup": "tsx scripts/cleanup-attachments.ts"
  },
  "dependencies": {
